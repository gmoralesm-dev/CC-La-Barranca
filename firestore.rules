rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check the user's role from their document in the database
    function getUserRole() {
      return get(/databases/$(database)/documents/Consejo-Comunal-La-Barranca/data/users/$(request.auth.uid)).data.role;
    }

    // Helper function to check if the user is a community manager or administrator
    function isManager() {
      return request.auth != null && 
        (getUserRole() == 'administrador' || 
         getUserRole() == 'admin' || 
         getUserRole() == 'lider_de_calle' || 
         getUserRole() == 'vocera_principal' ||
         getUserRole() == 'vocera' ||
         getUserRole() == 'vocero');
    }

    match /Consejo-Comunal-La-Barranca/{data} {
      
      // F2 FIX: Public read for announcements; only managers can publish/edit/delete posts.
      // Authenticated users can create comments with their own authorId; author or manager can edit/delete.
      match /comunicados/{comunicadoId} {
        allow read: if true;
        allow create, update, delete: if isManager();

        match /comments/{commentId} {
          allow read: if true;
          allow create: if request.auth != null && 
            request.resource.data.authorId == request.auth.uid;
          allow update, delete: if isManager() || 
            (request.auth != null && resource.data.authorId == request.auth.uid);
        }
      }

      // F3 FIX: Family and member data restricted to managers (protected personal information)
      match /families/{familyId} {
        allow read, write: if isManager();
        
        match /members/{memberId} {
          allow read, write: if isManager();
        }

        // F3 FIX: Financial and aid distribution records restricted to managers
        match /receipts/{receiptId} {
          allow read, write: if isManager();
        }
      }

      // F1 FIX: Users cannot assign or escalate their own role.
      // Only managers can grant elevated roles.
      match /users/{userId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isManager());
        allow create: if request.auth != null && (
          isManager() || 
          (request.auth.uid == userId && (!('role' in request.resource.data) || request.resource.data.role == 'desconocido' || request.resource.data.role == 'guest'))
        );
        allow update: if request.auth != null && (
          isManager() || 
          (request.auth.uid == userId && (!('role' in request.resource.data) || request.resource.data.role == resource.data.role))
        );
        allow delete: if isManager();
      }
      
      // F1 FIX: Guest session documents restricted
      match /invitados/{guestId} {
        allow read: if request.auth != null && (request.auth.uid == guestId || isManager());
        allow create: if request.auth != null && request.auth.uid == guestId && 
          (!('role' in request.resource.data) || request.resource.data.role == 'guest' || request.resource.data.role == 'desconocido');
        allow update: if request.auth != null && (
          isManager() || 
          (request.auth.uid == guestId && (!('role' in request.resource.data) || request.resource.data.role == resource.data.role))
        );
        allow delete: if isManager();
      }

      // F3 FIX: Delivery events restricted to managers
      match /deliveries/{eventId} {
        allow read, write: if isManager();
      }

      // F3 FIX: Certificates restricted to managers
      match /certificates/{certificateId} {
        allow read, write: if isManager();
      }

      // F3 FIX: Reports restricted to managers
      match /reports/{reportId} {
        allow read, write: if isManager();
      }
    }
  }
}